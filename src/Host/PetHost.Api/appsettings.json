{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Argon2": {
    "MemorySizeKib": 19456,
    "Iterations": 2,
    "DegreeOfParallelism": 1
  },
  "Jwt": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "Email": {
    "Port": 587,
    "FromName": "PetHost"
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "PetHost/1.0 (projeto academico)",
    "TimeoutSeconds": 10,
    "MinIntervalMilliseconds": 1100,
    "CacheHours": 168,
    "NotFoundCacheMinutes": 60
  },
  "Seed": {
    "Admin": {
      "Enabled": false,
      "FullName": "PetHost Admin"
    }
  }
}

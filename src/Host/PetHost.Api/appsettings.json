{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Argon2": {
    "MemorySizeKib": 19456,
    "Iterations": 2,
    "DegreeOfParallelism": 1
  },
  "Jwt": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "Email": {
    "Port": 587,
    "FromName": "PetHost"
  },
  "Stripe": {
    "ConnectReturnUrl": "http://localhost:3000/anfitriao/recebimentos?stripe=retorno",
    "ConnectRefreshUrl": "http://localhost:3000/anfitriao/recebimentos?stripe=renovar"
  },
  "HostPayouts": {
    "MaintenanceIntervalMinutes": 60,
    "ReminderDays": "3,7",
    "EnabledResyncHours": 24
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "PetHost/1.0 (projeto academico)",
    "TimeoutSeconds": 10,
    "MinIntervalMilliseconds": 1100,
    "CacheHours": 168,
    "NotFoundCacheMinutes": 60
  },
  "Seed": {
    "Admin": {
      "Enabled": false,
      "FullName": "PetHost Admin"
    }
  }
}

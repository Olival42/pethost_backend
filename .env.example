# =============================================================================
# PetHost - exemplo de variaveis de ambiente
#
#     cp .env.example .env
#
# O docker compose le o .env automaticamente. Ele NUNCA vai para o git.
# Os valores abaixo servem apenas para desenvolvimento local.
# =============================================================================

# --- API ---------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
BUILD_CONFIGURATION=Release
# Porta publicada no host (dentro da rede do compose a API e sempre api:8080)
API_HOST_PORT=8080

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=pethost
POSTGRES_USER=pethost
POSTGRES_PASSWORD=pethost_local_dev
POSTGRES_HOST_PORT=5432

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=pethost_local_dev
REDIS_HOST_PORT=6379

# --- JWT ---------------------------------------------------------------------
# Issuer e Audience precisam bater com o que a API valida no token.
JWT_ISSUER=https://api.pethost.local
JWT_AUDIENCE=pethost-app

# Key: minimo 32 bytes (256 bits) para HS256. Gere a sua com:
#     openssl rand -base64 48
JWT_KEY=troque-esta-chave-de-desenvolvimento-por-uma-gerada-com-openssl-rand

# Tempo de vida dos tokens. Access curto, refresh longo e rotativo.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Stripe ------------------------------------------------------------------
# Dashboard -> Developers -> API keys. Em dev use sempre as chaves de teste.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret do webhook criado apontando para a URL publica do ngrok (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- ngrok -------------------------------------------------------------------
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Dominio reservado (planos pagos), ex.: https://pethost.ngrok.app
# Vazio = o ngrok sorteia uma URL nova a cada `docker compose up`.
NGROK_URL=

# Inspector do agente: http://localhost:4040
NGROK_INSPECTOR_PORT=4040

# --- E-mail (SMTP) -----------------------------------------------------------
# Padrao: Mailpit do compose (captura tudo, nao entrega a ninguem).
# Caixa de entrada: http://localhost:8025
# Em producao, aponte para o SMTP real (SES, SendGrid, Mailgun...).
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=mailpit
EMAIL_FROM_NAME=PetHost
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- Esqueci a senha ---------------------------------------------------------
# Validade do token enviado por e-mail.
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
# Opcional: tela de nova senha no front, com {token} onde o token entra.
# Vazio = o e-mail traz so o codigo para copiar.
PASSWORD_RESET_URL=

# --- Imagens (bucket S3 compativel) -----------------------------------------
# Desenvolvimento: o RustFS do compose (padrao, nao precisa mexer).
# Console web: http://localhost:9001 (login com RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY)
RUSTFS_ACCESS_KEY=pethost
RUSTFS_SECRET_KEY=pethost_local_dev
RUSTFS_BUCKET_NAME=pethost-images
# Bucket privado (sem leitura publica): documentos da verificacao do anfitriao.
RUSTFS_PRIVATE_BUCKET_NAME=pethost-documents
RUSTFS_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001

# Para onde a API manda as imagens. Os valores abaixo apontam para o RustFS acima.
STORAGE_SERVICE_URL=http://rustfs:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=pethost
STORAGE_SECRET_ACCESS_KEY=pethost_local_dev
STORAGE_BUCKET_NAME=pethost-images
# Outro bucket, SEM acesso publico (no Supabase: bucket com "Public bucket" desligado).
STORAGE_PRIVATE_BUCKET_NAME=pethost-documents
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/pethost-images
STORAGE_FORCE_PATH_STYLE=true
# Links assinados dos documentos (bucket privado), que o admin abre no navegador.
# Endereco do S3 que o NAVEGADOR alcanca. So o RustFS precisa (a API fala com ele por
# http://rustfs:9000). Ao trocar para Supabase/R2, apague ou esvazie esta linha junto
# com o resto do bloco: vazio = usa STORAGE_SERVICE_URL.
STORAGE_SIGNED_URL_SERVICE_URL=http://localhost:9000
# Validade de cada link, em minutos (1 a 60).
STORAGE_SIGNED_URL_LIFETIME_MINUTES=5


# --- Seed do admin -----------------------------------------------------------
# O admin nao se cadastra pela API: e criado na subida, se ainda nao existir.
# Entra pelo login normal com "role": "admin".
SEED_ADMIN_ENABLED=true
SEED_ADMIN_FULL_NAME=PetHost Admin
SEED_ADMIN_EMAIL=admin@pethost.local
SEED_ADMIN_PASSWORD=troque-esta-senha-de-admin

# --- Verificacao do anfitriao -------------------------------------------------
# Dias que as fotos (documento e selfie) ficam no bucket privado depois que a
# solicitacao fecha (aprovada, recusada, cancelada ou expirada). 0 = apaga na hora.
HOST_VERIFICATION_DOCUMENT_RETENTION_DAYS=0
# Dias que um rascunho fica aberto antes de expirar (e perder as fotos).
HOST_VERIFICATION_DRAFT_LIFETIME_DAYS=7

# --- Anfitriao de demonstracao (apresentacao) --------------------------------
# Cria na subida um anfitriao JA VERIFICADO (sem passar pela fila do admin).
# Use so dados ficticios. A senha segue a regra de senha forte do cadastro.
# STRIPE_ACCOUNT_ID: conta conectada (acct_...) criada no Dashboard do Stripe;
# vazio = o anfitriao conecta o Stripe pelo app.
SEED_DEMO_HOST_ENABLED=false
SEED_DEMO_HOST_EMAIL=dona.cida@pethost.local
SEED_DEMO_HOST_PASSWORD=Troque@Esta123
SEED_DEMO_HOST_CPF=123.456.789-09
SEED_DEMO_HOST_STRIPE_ACCOUNT_ID=

<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core / Host">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Só a interface do Swagger: o documento é gerado pelo Microsoft.AspNetCore.OpenApi. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Persistencia">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Seguranca">
    <!-- Argon2id para hash de senha. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup Label="E-mail">
    <!-- SMTP. O System.Net.Mail.SmtpClient e marcado como nao recomendado pela Microsoft. -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!--
      Transitiva (MailKit -> MimeKit traz a 10.0.0). Fixada na versao corrigida dos alertas
      GHSA-2fmv-rv2c-59x7 e GHSA-846f-f764-76mx (CVE-2026-70162 e CVE-2026-84008, negacao de
      servico): com TreatWarningsAsErrors, o NU1902/NU1903 derrubava o restore no CI. O
      CentralPackageTransitivePinningEnabled faz esta versao valer para a dependencia indireta.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Armazenamento de imagens">
    <!-- S3 compativel: Cloudflare R2 em producao, RustFS em desenvolvimento e nos testes. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104" />
  </ItemGroup>

  <ItemGroup Label="Pagamentos">
    <!-- Stripe Connect (contas conectadas dos anfitrioes) e webhooks. Modo de teste. -->
    <PackageVersion Include="Stripe.net" Version="52.4.2" />
  </ItemGroup>

  <ItemGroup Label="Cache / sessao">
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup Label="Validacao e logs">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- FluentAssertions 8+ exige licenca paga. Fixado em 7.x (Apache-2.0). -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Cobertura via Microsoft.Testing.Platform: o coverlet.collector e um
         data collector do VSTest e nao roda no runner do xunit.v3. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Cliente do SignalR: só nos testes de integração do hub (o servidor usa o do framework).
         10.0.13 ou mais: até a 10.0.12 o SignalR.Common tem a CVE-2026-70159 (DoS, GHSA-334f-vvp4-7g6p). -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
  </ItemGroup>

</Project>
